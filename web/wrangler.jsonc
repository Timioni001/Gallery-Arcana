{
  // Cloudflare Workers deployment of the static demo build plus the waitlist API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gallery-arcana",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Waitlist storage: the "gallery-arcana-waitlist" KV namespace (created by the first deploy).
  "kv_namespaces": [{ "binding": "WAITLIST", "id": "ddf0aa3be7244c199bba77357ca8a89d" }]
}
