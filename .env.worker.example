# Copy to .env.worker for the separate worker only. Do not put this file in the API process.
WORKER_PORT=8081
WORKER_POLL_MS=5000
# Optional localhost simulator credential: openssl rand -hex 32. Empty disables /dev/pay.
# MOCK_SIMULATOR_TOKEN=
# Real wallet mode is disabled, regardless of RPC configuration. See docs/ZALLET_GAP.md.
# Optional read-only `npm run zallet:probe` settings. Never put credentials in .env.
# ZALLET_RPC_URL=http://127.0.0.1:8232
# ZALLET_RPC_USER=
# ZALLET_RPC_PASS=
# Bind an already-provisioned account/address; the probe never creates either.
# ZALLET_ACCOUNT_ID=
# ZALLET_RECEIVE_ADDRESS=
