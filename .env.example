# API/shared development configuration. Never put spending credentials in this file.
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana
API_HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
ZCASH_NETWORK=test
WALLET_DRIVER=mock
MIN_CONFIRMATIONS=2
ZEC_USD_FIXED=40
STORAGE_DIR=./storage
# Generate once with openssl rand -hex 32. Keep stable; never commit it.
ASSET_ENCRYPTION_KEY=
# Generate once with npm run keys; preserve both files and never publish the private key.
ATTESTATION_SIGNING_KEY_FILE=./secrets/arcana_ed25519_private.pem
ATTESTATION_VERIFY_KEY_FILE=./secrets/arcana_ed25519_public.pem
SESSION_DAYS=30
SESSION_ABSOLUTE_DAYS=90
# Optional loopback-only inspection endpoint; unset disables it.
ADMIN_TOKEN=
