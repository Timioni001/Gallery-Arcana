# API/shared development configuration. Never put spending credentials in this file.
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana
API_HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# test, or regtest ONLY to verify the Zallet adapter against a local Z3 regtest stack (docs/REGTEST.md)
ZCASH_NETWORK=test
# mock (default) or zallet. zallet is Zcash TESTNET only, unverified until the gate in
# docs/ZALLET_GAP.md passes, and needs ZALLET_TESTNET_ACK=unverified-testnet-only plus
# PRICE_SOURCE=market. Wallet RPC settings belong in .env.worker, never here.
WALLET_DRIVER=mock
# ZALLET_TESTNET_ACK=
# fixed uses ZEC_USD_FIXED (mock demo only); market uses worker-fetched exchange quotes.
PRICE_SOURCE=fixed
PRICE_MAX_AGE_SECONDS=120
MIN_CONFIRMATIONS=2
ESCROW_REVIEW_HOURS=1
ESCROW_DISPUTE_DAYS=7
ZEC_USD_FIXED=40
STORAGE_DIR=./storage
# Generate once with openssl rand -hex 32. Keep stable; never commit it.
ASSET_ENCRYPTION_KEY=
# Generate once with npm run keys; preserve both files and never publish the private key.
ATTESTATION_SIGNING_KEY_FILE=./secrets/arcana_ed25519_private.pem
ATTESTATION_VERIFY_KEY_FILE=./secrets/arcana_ed25519_public.pem
SESSION_DAYS=30
SESSION_ABSOLUTE_DAYS=90
# Optional loopback-only inspection endpoint; unset disables it.
ADMIN_TOKEN=
