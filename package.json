{
  "name": "gallery-arcana-backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx src/worker.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx scripts/test-integration.ts",
    "test:all": "npm run crypto:build && npm test && npm run test:integration && npm run typecheck",
    "payouts:reconcile": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/reconcile-payouts.ts",
    "zallet:probe": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/probe-zallet.ts",
    "keys": "node --import tsx scripts/generate-signing-key.ts",
    "assets:backfill": "node --env-file-if-exists=.env --import tsx scripts/backfill-asset-digests.ts",
    "demo:mock": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/demo-mock.ts",
    "crypto:build": "npm run build --workspace=@gallery-arcana/client-crypto",
    "setup:wsl": "bash scripts/setup-wsl.sh",
    "dev": "bash scripts/dev.sh",
    "regtest": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/regtest.ts",
    "admin": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "mock:pay": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/mock-pay.ts",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "journey:capsule": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/journey-capsule.ts"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "ethers": "6.17.0",
    "fastify": "^5.0.0",
    "pg": "^8.12.0",
    "sharp": "^0.35.5",
    "undici": "7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ]
}
