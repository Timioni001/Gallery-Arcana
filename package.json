{
  "name": "gallery-arcana-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:integration": "RUN_DB_TESTS=1 node --test --experimental-strip-types test/integration.test.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
