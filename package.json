{
  "name": "gallery-arcana-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx src/worker.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx scripts/test-integration.ts",
    "test:all": "npm test && npm run test:integration && npm run typecheck",
    "payouts:reconcile": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/reconcile-payouts.ts",
    "zallet:probe": "node --env-file-if-exists=.env --env-file-if-exists=.env.worker --import tsx scripts/probe-zallet.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.12.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
